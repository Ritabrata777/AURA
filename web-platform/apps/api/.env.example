# ===========================================
# Health Platform API - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -------------------------------------------
# Database Configuration
# -------------------------------------------
# PostgreSQL connection string for Prisma ORM
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# For local development:
# DATABASE_URL="postgresql://health_user:health_secure_password@localhost:5432/health_platform?schema=public"
#
# For Neon (serverless PostgreSQL):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/health_platform?schema=public"

# -------------------------------------------
# Authentication
# -------------------------------------------
# JWT signing secret - MUST be changed in production!
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# JWT expiration time
JWT_EXPIRATION="24h"

# -------------------------------------------
# Server Configuration
# -------------------------------------------
# API server port
PORT=3001

# Node environment (development | production | test)
NODE_ENV="development"

# -------------------------------------------
# CORS Configuration
# -------------------------------------------
# Frontend URL(s) allowed for CORS
# Comma-separated for multiple origins
FRONTEND_URL="http://localhost:3000"

# -------------------------------------------
# MQTT Broker Configuration
# -------------------------------------------
# MQTT broker URL for device communication
# Use mqtt:// for plain, mqtts:// for TLS
MQTT_URL="mqtt://localhost:1883"

# MQTT client ID prefix (will be appended with PID)
MQTT_CLIENT_ID_PREFIX="health-platform"

# MQTT username (if broker requires authentication)
MQTT_USERNAME=""

# MQTT password (if broker requires authentication)
MQTT_PASSWORD=""

# MQTT TLS CA certificate path (for mqtts://)
MQTT_CA_CERT_PATH=""

# MQTT TLS client certificate path (for mutual TLS)
MQTT_CLIENT_CERT_PATH=""

# MQTT TLS client key path (for mutual TLS)
MQTT_CLIENT_KEY_PATH=""

# -------------------------------------------
# GetStream Video Configuration (Optional)
# -------------------------------------------
# Required only for video consultation feature
# Sign up at https://getstream.io/
GETSTREAM_API_KEY=""
GETSTREAM_API_SECRET=""

# GetStream token expiration in seconds (default: 1 hour)
GETSTREAM_TOKEN_EXPIRATION=3600

# -------------------------------------------
# Security Configuration
# -------------------------------------------
# Bcrypt salt rounds for password hashing
# Higher = more secure but slower (10-12 recommended)
BCRYPT_SALT_ROUNDS=10

# Rate limiting (requests per minute per IP)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# -------------------------------------------
# Logging Configuration
# -------------------------------------------
# Log level (error | warn | info | http | verbose | debug | silly)
LOG_LEVEL="info"

# Log format (json | text)
LOG_FORMAT="text"

# -------------------------------------------
# WebSocket Configuration
# -------------------------------------------
# WebSocket ping interval in milliseconds
WEBSOCKET_PING_INTERVAL=30000

# Maximum number of WebSocket connections per room
WEBSOCKET_MAX_CONNECTIONS_PER_ROOM=100

# -------------------------------------------
# Database Pool Configuration
# -------------------------------------------
# Prisma connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -------------------------------------------
# Audit Logging
# -------------------------------------------
# Enable audit logging for sensitive operations
AUDIT_LOG_ENABLED=true

# Retention period for audit logs (days)
AUDIT_LOG_RETENTION_DAYS=365

# -------------------------------------------
# Health Check Configuration
# -------------------------------------------
# Enable health check endpoint
HEALTH_CHECK_ENABLED=true

# Health check endpoint path
HEALTH_CHECK_PATH="/health"

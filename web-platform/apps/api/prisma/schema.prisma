generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
  INDIVIDUAL_USER
}

enum RelationshipState {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

enum MeasurementType {
  HEART_RATE
  SPO2
  TEMPERATURE
}

enum MeasurementQuality {
  VALID
  INVALID
  UNAVAILABLE
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            UserRole
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  patient         Patient?
  doctor          Doctor?
  individualUser  IndividualUser?
  auditLogs       AuditLog[]
  appointmentsAsPatient Appointment[] @relation("patientAppointments")
  appointmentsAsDoctor  Appointment[] @relation("doctorAppointments")
}

model Patient {
  id          String           @id @default(uuid())
  userId      String           @unique
  user        User             @relation(fields: [userId], references: [id])
  devices     PatientDevice[]
  doctors     DoctorPatient[]  @relation("patientRelationships")
  measurements Measurement[]
  ecgSessions EcgSession[]
  prescriptions Prescription[]
  createdAt   DateTime         @default(now())
}

model Doctor {
  id          String          @id @default(uuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id])
  patients    DoctorPatient[] @relation("doctorRelationships")
  prescriptions Prescription[]
  createdAt   DateTime        @default(now())
}

// Personal wellness users — not clinical patients.
// They own devices and measurements but have no doctor relationships,
// no prescriptions, and no appointments.
model IndividualUser {
  id          String                  @id @default(uuid())
  userId      String                  @unique
  user        User                    @relation(fields: [userId], references: [id])
  devices     IndividualUserDevice[]
  measurements IndividualMeasurement[]
  ecgSessions  IndividualEcgSession[]
  createdAt   DateTime                @default(now())
}

model IndividualUserDevice {
  individualUserId String
  deviceId         String
  pairedAt         DateTime       @default(now())
  individualUser   IndividualUser @relation(fields: [individualUserId], references: [id])
  device           Device         @relation(fields: [deviceId], references: [id])
  @@id([individualUserId, deviceId])
}

model IndividualMeasurement {
  id               String             @id @default(uuid())
  individualUserId String
  deviceId         String
  type             MeasurementType
  value            Float
  unit             String
  quality          MeasurementQuality
  sessionId        String
  measuredAt       DateTime
  createdAt        DateTime           @default(now())
  individualUser   IndividualUser     @relation(fields: [individualUserId], references: [id])
  device           Device             @relation(fields: [deviceId], references: [id])
  @@index([individualUserId, measuredAt])
  @@index([individualUserId, type, measuredAt])
}

model IndividualEcgSession {
  id               String               @id @default(uuid())
  individualUserId String
  deviceId         String
  sampleRate       Int
  startedAt        DateTime
  endedAt          DateTime?
  createdAt        DateTime             @default(now())
  individualUser   IndividualUser       @relation(fields: [individualUserId], references: [id])
  device           Device               @relation(fields: [deviceId], references: [id])
  chunks           IndividualEcgChunk[]
  @@index([individualUserId, startedAt])
}

model IndividualEcgChunk {
  id          String               @id @default(uuid())
  sessionId   String
  sequence    Int
  timestamp   DateTime
  samples     Json
  createdAt   DateTime             @default(now())
  session     IndividualEcgSession @relation(fields: [sessionId], references: [id])
  @@unique([sessionId, sequence])
  @@index([sessionId, sequence])
}

model Device {
  id           String          @id @default(uuid())
  hardwareId   String          @unique
  pairingCode  String          @unique
  credentialHash String
  lastSeenAt   DateTime?
  createdAt    DateTime        @default(now())
  patientLinks PatientDevice[]
  individualUserLinks IndividualUserDevice[]
  measurements Measurement[]
  ecgSessions  EcgSession[]
  individualMeasurements IndividualMeasurement[]
  individualEcgSessions  IndividualEcgSession[]
}

model PatientDevice {
  patientId  String
  deviceId   String
  pairedAt   DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id])
  device     Device   @relation(fields: [deviceId], references: [id])
  @@id([patientId, deviceId])
}

model DoctorPatient {
  doctorId   String
  patientId  String
  state      RelationshipState @default(PENDING)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  doctor     Doctor  @relation("doctorRelationships", fields: [doctorId], references: [id])
  patient    Patient @relation("patientRelationships", fields: [patientId], references: [id])
  @@id([doctorId, patientId])
}

model Measurement {
  id              String            @id @default(uuid())
  patientId       String
  deviceId        String
  type            MeasurementType
  value           Float
  unit            String
  quality         MeasurementQuality
  sessionId       String
  measuredAt      DateTime
  createdAt       DateTime          @default(now())
  patient         Patient           @relation(fields: [patientId], references: [id])
  device          Device            @relation(fields: [deviceId], references: [id])
  @@index([patientId, measuredAt])
  @@index([patientId, type, measuredAt])
}

model EcgSession {
  id          String      @id @default(uuid())
  patientId   String
  deviceId    String
  sampleRate  Int
  startedAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime    @default(now())
  patient     Patient     @relation(fields: [patientId], references: [id])
  device      Device      @relation(fields: [deviceId], references: [id])
  chunks      EcgChunk[]
  @@index([patientId, startedAt])
}

model EcgChunk {
  id          String     @id @default(uuid())
  sessionId   String
  sequence    Int
  timestamp   DateTime
  samples     Json
  createdAt   DateTime   @default(now())
  session     EcgSession @relation(fields: [sessionId], references: [id])
  @@unique([sessionId, sequence])
  @@index([sessionId, sequence])
}

model Appointment {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String
  startsAt  DateTime
  endsAt    DateTime
  streamCallId String?
  status    String   @default("SCHEDULED")
  createdAt DateTime @default(now())
  patient   User     @relation("patientAppointments", fields: [patientId], references: [id])
  doctor    User     @relation("doctorAppointments", fields: [doctorId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  @@index([resource, createdAt])
  @@index([userId, createdAt])
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Prescription {
  id            String                  @id @default(uuid())
  patientId     String
  doctorId      String
  diagnosis     String
  notes         String?
  status        PrescriptionStatus      @default(ACTIVE)
  createdById   String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  patient       Patient                 @relation(fields: [patientId], references: [id])
  doctor        Doctor                  @relation(fields: [doctorId], references: [id])
  medications   PrescriptionMedication[]
  @@index([patientId, createdAt])
  @@index([doctorId, patientId])
}

model PrescriptionMedication {
  id             String         @id @default(uuid())
  prescriptionId String
  drug           String
  dose           String
  frequency      String
  duration       String?
  route          String?
  instructions   String?
  createdAt      DateTime       @default(now())
  prescription   Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  @@index([prescriptionId])
}

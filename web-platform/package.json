{
  "name": "health-monitoring-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @health-platform/protocol && npm run build --workspace=@health-platform/api --workspace=@health-platform/web",
    "dev:api": "npm run start:dev -w @health-platform/api",
    "dev:web": "npm run dev -w @health-platform/web",
    "typecheck": "npm run build -w @health-platform/protocol && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "lightningcss-win32-x64-msvc": "^1.28.1"
  },
  "dependencies": {
    "lightningcss": "^1.28.1"
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-cache": "0.84.5",
    "metro-config": "0.84.5",
    "metro-core": "0.84.5",
    "metro-resolver": "0.84.5",
    "metro-runtime": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "metro-react-native-babel-preset": "0.84.5"
  }
}
